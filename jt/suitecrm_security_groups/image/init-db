#!/bin/sh
set -eu

mkdir -p /var/lib/mysql /run/mysqld
chown -R www-data:www-data /var/lib/mysql /run/mysqld
mariadb-install-db --user=www-data --datadir=/var/lib/mysql \
  --auth-root-authentication-method=normal
mariadbd --user=www-data --datadir=/var/lib/mysql \
  --socket=/run/mysqld/mysqld.sock --pid-file=/run/mysqld/build.pid \
  --skip-networking &
db_pid=$!
for _ in $(seq 1 30); do
  if mariadb-admin --socket=/run/mysqld/mysqld.sock ping >/dev/null 2>&1; then
    break
  fi
  sleep 1
done
mariadb --socket=/run/mysqld/mysqld.sock -uroot -e \
  "CREATE DATABASE suitecrm CHARACTER SET utf8 COLLATE utf8_general_ci;
   CREATE USER 'suitecrm'@'127.0.0.1' IDENTIFIED BY 'suitecrm-local-db-pass';
   GRANT ALL PRIVILEGES ON suitecrm.* TO 'suitecrm'@'127.0.0.1';
   FLUSH PRIVILEGES;"
mariadb-admin --socket=/run/mysqld/mysqld.sock -uroot shutdown
wait "$db_pid"
